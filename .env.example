# Web Quality Sentinel — environment variables (ALL OPTIONAL).
# Copy to `.env` and adjust. The project runs fully with none of these set.

# --- Health Monitor tuning ---
# Page-load performance budget in milliseconds.
PERF_THRESHOLD_MS=4000
# Max links to status-check per page (keeps runs fast & polite).
MAX_LINKS_PER_PAGE=20
# Per-link request timeout in milliseconds.
LINK_CHECK_TIMEOUT_MS=10000

# --- Optional: Discord notifications ---
# If set (e.g. as a GitHub Secret), a run summary is posted to this webhook.
# Leave unset to skip notifications silently.
DISCORD_WEBHOOK_URL=

# --- Optional: AI-enhanced test generation (Google Gemini free tier) ---
# If set, `npm run generate` produces richer, AI-authored test cases.
# Without it, the generator falls back to deterministic templates.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
